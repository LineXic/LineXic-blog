<div id="tcomment"></div>

<script>
  function loadTwikoo() {
    const commentsContainer = document.getElementById("tcomment");
    if (!commentsContainer) return;

    const script = document.createElement("script");
    script.src =
      "https://cdn.linexic.top/npm/twikoo@1.7.16/dist/twikoo.min.js";
    script.integrity =
      "sha512-q62Nd9Wnk8onS7keK8VzR5FvikdDz15vhABrdbeGcl9wEHFGDXkLDiq6rx8UCVNw6ysARm1pp/+b2cz+rsEWgw==";
    script.crossOrigin = "anonymous";
    script.referrerPolicy = "no-referrer";

    script.onload = () => {
      twikoo.init({
        envId: "https://talk.linexic.top/.netlify/functions/twikoo",
        el: "#tcomment",
        lang: "zh-CN",
      });
    };

    document.body.appendChild(script);
  }

  loadTwikoo();
</script>
